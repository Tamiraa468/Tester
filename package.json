    "db:reset": "prisma migrate reset",
    "import:questions": "tsx scripts/import-questions.ts",
    "template:make": "tsx scripts/make-template.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/localizations": "^4.16.1",
    "@clerk/nextjs": "^7.9.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "17.4.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
