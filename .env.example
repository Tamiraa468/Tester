# Copy to .env and adjust.
# DATABASE_URL: used by the app at runtime (pooled connection in production).
# DIRECT_URL: direct connection, used by migrate, seed and import commands.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/phd_prep"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/phd_prep"
# TEST_DATABASE_URL: used ONLY by `pnpm test:db`. Must be a separate database whose name
# ends with "_test"; create it with `pnpm test:db:setup`.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/phd_prep_test"

# Clerk (https://dashboard.clerk.com -> API keys). Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Clerk routes: custom sign-in/up pages and where to go after auth
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Public site origin, used for absolute og:image URLs in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
